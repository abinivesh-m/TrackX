# frontend/.env.example
#
# Copy to frontend/.env (already gitignored) and fill in values as needed.
# Nothing here is required to run TrackX - every setting has a working,
# no-account-needed default baked into the code.

# Base URL the frontend uses to reach the TrackX API. Defaults to
# http://localhost:8000 in development if unset - see src/services/api.ts.
# VITE_API_URL=http://localhost:8000

# Map tile provider (see src/config/mapTiles.ts). Defaults to standard
# OpenStreetMap raster tiles, which need no account or API key. Only set
# these if you want a different provider (e.g. a paid one with better
# styling) - if that provider needs a key, put the whole tile URL template
# with the key embedded here, in your own local/deployment .env file. Never
# commit a real key to this .env.example file or anywhere else in the repo.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
