# TrackX Production Environment Configuration
# Copy this file to .env and update with your production values.
# DO NOT commit real secrets into version control.

# ================================
# SECURITY - GENERATE FOR PRODUCTION
# ================================
# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_BASE64_STRING

# ================================
# ENVIRONMENT
# ================================
ENVIRONMENT=production

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL+PostGIS for production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trackx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=trackx

# SQLite fallback (development only)
USE_SQLITE=false
SQLITE_DB_PATH=backend/trackx.db

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# AI PIPELINE CONFIGURATION
# ================================
# VEHICLE_WEIGHTS intentionally left unset - config.py auto-detects
# models/best_vehicle.pt (the real trained checkpoint) if present and only
# falls back to yolov8n.pt otherwise. Setting it here would override that
# auto-detection for every dev who copies this file (see the long comment
# in backend/.env, dated 2026-09-15, for why this matters).
# VEHICLE_WEIGHTS=yolov8n.pt
PLATE_WEIGHTS=models/best_plate_detector.pt
OCR_MODEL_PATH=models/lprnet_indian.pth

# ================================
# CAMERA CONFIGURATION
# ================================
CAMERA_COUNT=7
DEFAULT_FRAME_SAMPLE=10
MAX_FRAME_PROCESSING=1000

# ================================
# REAL RTSP/RTSPS CAMERA (per camera id, e.g. CAM_01)
# ================================
# Every camera in network/camera_network.py (CAM_01..CAM_07) keeps using
# its simulated local video by default - nothing below changes that unless
# you set it. To point one camera at a real CP PLUS (or Dahua-derived)
# RTSP/RTSPS camera, uncomment and fill in ONLY the vars you need for that
# camera id. Full details/defaults for every var: see the module docstring
# in network/rtsp_camera.py. NEVER commit real values here - this file is
# the example; put real values only in backend/.env (already .gitignored).
#
# Recommended: use the full-URL override (_URL) - it's the one this
# project's own real CP PLUS camera was verified against, and needs no
# other var except _TLS_VERIFY:
# TRACKX_RTSP_CAM_01_URL=rtsps://<host>:<port>/video/live?channel=1&subtype=0
# TRACKX_RTSP_CAM_01_TLS_VERIFY=0        # CP PLUS's self-signed cert - required for rtsps://
# TRACKX_RTSP_CAM_01_TRANSPORT=tcp       # "tcp" (default) or "udp"
# TRACKX_RTSP_CAM_01_ROTATION=0          # 0 (default)/90/180/270 clockwise - set if the
#                                         # decoded frame comes out sideways/upside down
#
# Alternative: build the URL from separate component vars instead of one
# full _URL (useful if you don't want the password embedded in one string):
# TRACKX_RTSP_CAM_01_HOST=<camera-ip>
# TRACKX_RTSP_CAM_01_PORT=554
# TRACKX_RTSP_CAM_01_USERNAME=<username>
# TRACKX_RTSP_CAM_01_PASSWORD=<password>
# TRACKX_RTSP_CAM_01_CHANNEL=1
# TRACKX_RTSP_CAM_01_SUBTYPE=0
# TRACKX_RTSP_CAM_01_SCHEME=rtsps
# TRACKX_RTSP_CAM_01_PATH_STYLE=video_live   # "dahua" (default) or "video_live"
#
# Repeat the same pattern with _CAM_02_, _CAM_03_, etc. for additional
# real cameras.

# ================================
# ADMIN CREDENTIALS - CHANGE IMMEDIATELY
# ================================
# DEMO ONLY - the demo login is admin@trackx.com / admin123.
# In production, set a unique superuser and strong password here.
FIRST_SUPERUSER=admin@trackx.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_IMMEDIATELY

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/trackx.log

# ================================
# CORS CONFIGURATION
# ================================
# JSON array of allowed origins (pydantic-settings parses complex fields as JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
