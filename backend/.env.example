# TrackX Production Environment Configuration
# Copy this file to .env and update with your production values.
# DO NOT commit real secrets into version control.

# ================================
# SECURITY - GENERATE FOR PRODUCTION
# ================================
# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_BASE64_STRING

# ================================
# ENVIRONMENT
# ================================
ENVIRONMENT=production

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL+PostGIS for production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trackx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=trackx

# SQLite fallback (development only)
USE_SQLITE=false
SQLITE_DB_PATH=backend/trackx.db

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# AI PIPELINE CONFIGURATION
# ================================
VEHICLE_WEIGHTS=yolov8n.pt
PLATE_WEIGHTS=models/best_plate_detector.pt
OCR_MODEL_PATH=models/lprnet_indian.pth

# ================================
# CAMERA CONFIGURATION
# ================================
CAMERA_COUNT=7
DEFAULT_FRAME_SAMPLE=10
MAX_FRAME_PROCESSING=1000

# ================================
# ADMIN CREDENTIALS - CHANGE IMMEDIATELY
# ================================
# DEMO ONLY - the demo login is admin@trackx.com / admin123.
# In production, set a unique superuser and strong password here.
FIRST_SUPERUSER=admin@trackx.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_IMMEDIATELY

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/trackx.log

# ================================
# CORS CONFIGURATION
# ================================
# JSON array of allowed origins (pydantic-settings parses complex fields as JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
