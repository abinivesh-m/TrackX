# TrackX Production Environment Configuration
# For development use - update with your production values

# ================================
# SECURITY - CRITICAL FOR PRODUCTION
# ================================
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev_trackx_secret_key_change_for_production_64chars_minimum_security_requirement

# ================================
# ENVIRONMENT
# ================================
ENVIRONMENT=development

# ================================
# DATABASE CONFIGURATION
# ================================
# SQLite fallback (development only)
USE_SQLITE=true
SQLITE_DB_PATH=backend/trackx.db

# PostgreSQL+PostGIS for production (commented out for development)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=trackx
# POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DATABASE_PASSWORD
# POSTGRES_DB=trackx

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# AI PIPELINE CONFIGURATION
# ================================
VEHICLE_WEIGHTS=yolov8n.pt
PLATE_WEIGHTS=models/best_plate_detector.pt
OCR_MODEL_PATH=models/lprnet_indian.pth

# ================================
# CAMERA CONFIGURATION
# ================================
CAMERA_COUNT=7
DEFAULT_FRAME_SAMPLE=10
MAX_FRAME_PROCESSING=1000

# ================================
# ADMIN CREDENTIALS - CHANGE IMMEDIATELY
# ================================
# Demo credential documented on the login page: admin@trackx.com / admin123
FIRST_SUPERUSER=admin@trackx.com
FIRST_SUPERUSER_PASSWORD=admin123

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/trackx.log

# ================================
# CORS CONFIGURATION
# ================================
# JSON array of allowed origins (pydantic-settings parses complex fields as JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]