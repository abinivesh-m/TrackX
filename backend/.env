# TrackX — Local development environment
# ⚠️ DEMO ONLY — these defaults are for local development/demo.
# For production set ENVIRONMENT=production, strong SECRET_KEY, and
# DATABASE_URL / POSTGRES_* to real values. Never commit real secrets.

# Security (demo key only — replace for any shared deployment)
SECRET_KEY=dev_trackx_secret_key_change_for_production_64chars_minimum_security_requirement

ENVIRONMENT=development

# --- Database: SQLite (local dev/demo) ---
USE_SQLITE=true
SQLITE_DB_PATH=backend/trackx.db

# --- PostgreSQL (used only when USE_SQLITE=false) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trackx
POSTGRES_PASSWORD=trackx_password
POSTGRES_DB=trackx
# DATABASE_URL=postgresql://trackx:trackx_password@localhost:5432/trackx

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI pipeline weights ---
VEHICLE_WEIGHTS=yolov8n.pt
PLATE_WEIGHTS=models/best_plate_detector.pt
OCR_MODEL_PATH=models/lprnet_indian.pth

CAMERA_COUNT=7
DEFAULT_FRAME_SAMPLE=10
MAX_FRAME_PROCESSING=1000

# Demo admin credential (documented on the login page): admin@trackx.com / admin123
FIRST_SUPERUSER=admin@trackx.com
FIRST_SUPERUSER_PASSWORD=admin123

LOG_LEVEL=INFO
LOG_FILE=logs/trackx.log

# CORS — local dev origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
